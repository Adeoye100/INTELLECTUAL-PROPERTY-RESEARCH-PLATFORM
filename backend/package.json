{
  "name": "backend",
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.1",
  "description": "Express API for the Intellectual Property Research Platform",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node src/server.js",
    "watch:worker": "node src/watch/run-watch-worker.js",
    "watch:worker:dev": "node --env-file=.env src/watch/run-watch-worker.js",
    "pdf-export:worker": "node src/exports/run-pdf-export-worker.js",
    "pdf-export:worker:dev": "node --env-file=.env src/exports/run-pdf-export-worker.js",
    "migrate": "node src/db/migrate.js",
    "indices:elasticsearch": "node scripts/create-elasticsearch-indices.js",
    "ingest:uspto": "node src/ingestion/run-uspto-ingestion.js",
    "sync:elasticsearch": "node src/ingestion/run-elasticsearch-sync.js",
    "verify:supabase-token": "node --env-file=.env scripts/verify-supabase-token.js",
    "verify:supabase-rbac": "node --env-file=.env scripts/verify-supabase-rbac.js",
    "phase2:readiness": "node scripts/phase2-readiness.js",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --env-file=.env --test --test-concurrency=1 test/integration/*.test.js",
    "test:staging-smoke": "node scripts/staging-smoke-test.js",
    "check": "node scripts/check-source.js",
    "migration:check": "node scripts/check-migrations.js",
    "security:secrets": "git ls-files -z | node scripts/secret-scan.js",
    "security:frontend-secrets": "node scripts/check-frontend-secrets.js",
    "openapi:check": "node scripts/check-openapi.js"
  },
  "keywords": [],
  "author": "ADept - Adeoye Emmanuel Opeyemi",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "jose": "^6.2.8",
    "pg": "^8.22.0",
    "redis": "^6.2.0",
    "saxes": "^6.0.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
