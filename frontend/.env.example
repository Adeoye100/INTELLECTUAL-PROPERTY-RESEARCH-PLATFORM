# Browser-safe Supabase project settings. Never place a secret/service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Required for every live deployment. The value must end in /api/v1.
VITE_API_BASE_URL=https://api.example.com/api/v1

# Optional. Omit this or set it to live for staging and production.
# mock is accepted only by `vite` development builds and starts MSW.
VITE_API_MODE=live

# Public organization creation is disabled by default; invitations still work.
VITE_PUBLIC_FIRM_SIGNUP_ENABLED=false

# Auth callbacks deliberately use window.location.origin so Vercel previews use
# their exact deployed origin. Do not add a static production callback URL here.
